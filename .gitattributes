# Normalize text files and use LF in the repository
* text=auto eol=lf

# Python
*.py text eol=lf

# Markdown / config / text
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# Shell / Docker / devcontainer
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Notebooks are JSON, keep LF
*.ipynb text eol=lf

# SQL
*.sql text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.sqlite binary
*.db binary
*.parquet binary
*.pkl binary